<?xml version="1.0"?>
<sdf version="1.12">
  <world name="plane">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Match spawn_heaps.launch.py: 10 cm cube, 0.1 kg, 2 cm tag images. -->
    <model name="tagged_cube">
      <pose>0 0 0.05 0 0 0</pose>
      <link name="cube">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000166666667</ixx>
            <iyy>0.000166666667</iyy>
            <izz>0.000166666667</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </collision>
        <visual name="cube">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>

        <!-- Four corners on the +X face, 0.2 mm above the cube surface. -->
        <visual name="apriltag_0">
          <pose>0.0502 -0.04 0.04 -1.570796327 0 0</pose>
          <geometry><plane><normal>1 0 0</normal><size>0.02 0.02</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.2 0.2 0.2 1</emissive>
            <pbr><metal>
              <albedo_map>package://scratchpad/textures/tag36_11_00000.png</albedo_map>
              <emissive_map>package://scratchpad/textures/tag36_11_00000.png</emissive_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
        <visual name="apriltag_1">
          <pose>0.0502 0.04 0.04 -1.570796327 0 0</pose>
          <geometry><plane><normal>1 0 0</normal><size>0.02 0.02</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.2 0.2 0.2 1</emissive>
            <pbr><metal>
              <albedo_map>package://scratchpad/textures/tag36_11_00001.png</albedo_map>
              <emissive_map>package://scratchpad/textures/tag36_11_00001.png</emissive_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
        <visual name="apriltag_2">
          <pose>0.0502 -0.04 -0.04 -1.570796327 0 0</pose>
          <geometry><plane><normal>1 0 0</normal><size>0.02 0.02</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.2 0.2 0.2 1</emissive>
            <pbr><metal>
              <albedo_map>package://scratchpad/textures/tag36_11_00002.png</albedo_map>
              <emissive_map>package://scratchpad/textures/tag36_11_00002.png</emissive_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
        <visual name="apriltag_3">
          <pose>0.0502 0.04 -0.04 -1.570796327 0 0</pose>
          <geometry><plane><normal>1 0 0</normal><size>0.02 0.02</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.2 0.2 0.2 1</emissive>
            <pbr><metal>
              <albedo_map>package://scratchpad/textures/tag36_11_00003.png</albedo_map>
              <emissive_map>package://scratchpad/textures/tag36_11_00003.png</emissive_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="inspection_camera">
      <static>true</static>
      <!-- 30 cm horizontally from the tagged face, aimed at its centre.
           Height = 0.05 + 0.30 * tan(30 degrees); downward pitch = 30 degrees. -->
      <pose>4.0 4.9 0.5223205081 0 1.5708 3.141592654</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <topic>/scratchpad/camera/image_raw</topic>
          <frame_id>scratchpad_camera_optical_frame</frame_id>
          <camera>
            <camera_info_topic>/scratchpad/camera/camera_info</camera_info_topic>
            <horizontal_fov>1.047197551</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.01</near><far>10</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
