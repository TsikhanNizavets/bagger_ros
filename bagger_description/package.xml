<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bagger_description</name>
  <version>0.1.0</version>
  <description>Provides the bagger robot model</description>
  <maintainer email="tsikhannizavets@gmail.com">Tsikhan Nizavets</maintainer>
  <license>MIT</license>

  <build_depend>python3-setuptools</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>gz_sim_vendor</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
